# sentinelone-mcp configuration — copy to `.env` and fill in.
# This file holds SECRETS (API tokens). Keep `.env` out of version control.

# ---- server ----------------------------------------------------------------
# Transport: docker compose forces `http`; for local stdio runs use `stdio`.
MCP_TRANSPORT=http
MCP_BIND=0.0.0.0:8080
# Enable destructive tools (isolate/reconnect). Off by default.
MCP_ALLOW_ACTIONS=false

# ---- tenants ---------------------------------------------------------------
# Comma-separated tenant ids. Each id <ID> is upper-cased for its var prefix.
S1_TENANTS=acme,globex
# Tenant used when a tool call omits `tenant` (optional if only one tenant).
S1_DEFAULT_TENANT=acme

# --- tenant: acme (both backends) ---
S1_TENANT_ACME_NAME=Acme Prod
S1_TENANT_ACME_GROUPS=prod,emea
S1_TENANT_ACME_MGMT_HOST=https://apse1-2111-mssp.sentinelone.net
S1_TENANT_ACME_MGMT_TOKEN=replace-with-mgmt-api-token
S1_TENANT_ACME_XDR_HOST=https://xdr.ap1.sentinelone.net
S1_TENANT_ACME_XDR_TOKEN=replace-with-xdr-bearer-token

# --- tenant: globex (management only) ---
S1_TENANT_GLOBEX_NAME=Globex
S1_TENANT_GLOBEX_GROUPS=prod
S1_TENANT_GLOBEX_MGMT_HOST=https://usea1-tenant.sentinelone.net
S1_TENANT_GLOBEX_MGMT_TOKEN=replace-with-mgmt-api-token
# (no XDR_* vars → this tenant has no XDR backend; xdr tools error cleanly for it)
