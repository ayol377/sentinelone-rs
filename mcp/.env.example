# sentinelone-mcp configuration — copy to `.env` and fill in.
# This file holds SECRETS (API tokens). Keep `.env` out of version control.

# ---- server ----------------------------------------------------------------
# Transport: docker compose forces `http`; for local stdio runs use `stdio`.
MCP_TRANSPORT=http
MCP_BIND=0.0.0.0:8080
# Enable destructive tools (isolate/reconnect). Off by default.
MCP_ALLOW_ACTIONS=false

# ---- tenants ---------------------------------------------------------------
# Comma-separated tenant ids. Each id <ID> is upper-cased for its var prefix.
S1_TENANTS=acme,globex

# ---- tenant confinement (MSSP) ---------------------------------------------
# THREAT MODEL: a SentinelOne service-user token is normally *account*-scoped —
# it can read every site in the account, so the token cannot stop an agent
# investigating customer A from reading customer B's data. Nor can the calling
# application: `site_ids` injected into tool arguments is client-side and one
# bug away from being bypassed.
#
# Set S1_TENANT_<ID>_SITE_IDS to confine a tenant *server-side*. The server then
# strips every caller-supplied siteIds/accountIds/groupIds/tenant parameter
# (named args and the `filters` splat alike), intersects any site the caller did
# ask for with this list, and appends the result to every Management API call.
# A request for a site outside the list is refused, not silently widened.
# Leave unset for the current, unrestricted behaviour.
#
#   S1_TENANT_ACME_SITE_IDS=225494730938493804
#   S1_TENANT_ACME_ACCOUNT_IDS=225494730938493111   # customers owning a whole account
#
# Two escape hatches cannot be confined and are refused for a confined tenant.
# Re-enable them only if you accept that they can read outside the scope:
#   S1_TENANT_ACME_UNSAFE_ALLOW_XDR=true       # PowerQuery/DataSet query text is caller-authored
#   S1_TENANT_ACME_UNSAFE_ALLOW_RAW_GET=true   # s1_get_raw can hit paths that ignore siteIds
# (s1_post_raw is always refused for a confined tenant; there is no opt-out.)

# --- tenant: acme (both backends) ---
S1_TENANT_ACME_NAME=Acme Prod
S1_TENANT_ACME_GROUPS=prod,emea
S1_TENANT_ACME_MGMT_HOST=https://apse1-2111-mssp.sentinelone.net
S1_TENANT_ACME_MGMT_TOKEN=replace-with-mgmt-api-token
S1_TENANT_ACME_XDR_HOST=https://xdr.ap1.sentinelone.net
S1_TENANT_ACME_XDR_TOKEN=replace-with-xdr-bearer-token

# --- tenant: globex (management only) ---
S1_TENANT_GLOBEX_NAME=Globex
S1_TENANT_GLOBEX_GROUPS=prod
S1_TENANT_GLOBEX_MGMT_HOST=https://usea1-tenant.sentinelone.net
S1_TENANT_GLOBEX_MGMT_TOKEN=replace-with-mgmt-api-token
# (no XDR_* vars → this tenant has no XDR backend; xdr tools error cleanly for it)
# Confined to a single customer site: this server physically cannot return data
# for any other site, whatever the caller asks for.
S1_TENANT_GLOBEX_SITE_IDS=225494730938493804
